# =====================================================================
# Lambda Calculus 綜合範例檔案
# 包含：Combinators, Pairs (cons/car/cdr), Numerals, Factorial, Fibonacci
# =====================================================================

# ---------------------------------------------------------------------
# 1. 基本組合子 (Combinators)
# ---------------------------------------------------------------------
I = \x. x
K = \x. \y. x
S = \x. \y. \z. x z (y z)
Y = \f. (\x. f (x x)) (\x. f (x x))

# 測試組合子運作
I a
K a b
S K K a

# ---------------------------------------------------------------------
# 2. 邱奇對與清單操作 (Church Pairs: CONS, CAR, CDR)
# ---------------------------------------------------------------------
CONS = \x. \y. \f. f x y
CAR = \p. p (\x. \y. x)
CDR = \p. p (\x. \y. y)

# 測試 CONS、CAR、CDR 取出對組中的元素
CAR (CONS a b)
CDR (CONS a b)

# ---------------------------------------------------------------------
# 3. 邱奇數字與基本算術 (Church Numerals & Arithmetic)
# ---------------------------------------------------------------------
ZERO = \f. \x. x
SUCC = \n. \f. \x. f (n f x)
ONE = \f. \x. f x
TWO = \f. \x. f (f x)
THREE = \f. \x. f (f (f x))

PLUS = \m. \n. \f. \x. m f (n f x)
MULT = \m. \n. \f. m (n f)

# 測試加法與乘法
PLUS ONE TWO
MULT TWO THREE

# ---------------------------------------------------------------------
# 4. 邏輯判斷與前驅函數 (Conditionals & Predecessor)
# ---------------------------------------------------------------------
TRUE = \t. \f. t
FALSE = \t. \f. f
IF = \p. \a. \b. p a b

ISZERO = \n. n (\x. FALSE) TRUE
PRED = \n. \f. \x. n (\g. \h. h (g f)) (\u. x) (\u. u)
SUB = \m. \n. n PRED m
LEQ = \m. \n. ISZERO (SUB m n)

# 測試條件與前驅
ISZERO ZERO
ISZERO ONE
PRED TWO

# ---------------------------------------------------------------------
# 5. 階乘範例 (Factorial, n!)
# ---------------------------------------------------------------------
# 定義：FACT = Y (\f. \n. ISZERO n ONE (MULT n (f (PRED n))))
FACT = Y (\f. \n. IF (ISZERO n) ONE (MULT n (f (PRED n))))

# 測試 2 的階乘 (2! = 2，結果應等於 TWO)
FACT TWO

# ---------------------------------------------------------------------
# 6. 費氏數列範例 (Fibonacci)
# ---------------------------------------------------------------------
# 定義：FIB(n) = if n <= 1 then n else FIB(n-1) + FIB(n-2)
FIB = Y (\f. \n. IF (LEQ n ONE) n (PLUS (f (SUB n ONE)) (f (SUB n (SUCC ZERO)))))

# 測試費氏數列第 3 項 (F(3) = 2，結果應等於 TWO)
FIB THREE